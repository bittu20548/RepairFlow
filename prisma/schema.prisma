
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum RepairStatus {
  RECEIVED
  DIAGNOSING
  WAITING_FOR_APPROVAL
  APPROVED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  READY_FOR_PICKUP
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  SUCCESS
  FAILED
  REFUNDED
}

// ==================== SHOP ====================

model Shop {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repairTickets RepairTicket[]
  payments      Payment[]
}

// ==================== CUSTOMER ====================

model Customer {
  id           String   @id @default(uuid())
  name         String
  phone        String   @unique
  email        String?  @unique
  passwordHash String?
  address      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repairTickets RepairTicket[]
}

// ==================== REPAIR TICKET ====================

model RepairTicket {
  id           String       @id @default(uuid())
  ticketNumber String
  deviceType   String
  brand        String
  model        String
  imei         String?
  problem      String

  status        RepairStatus @default(RECEIVED)
  estimatedCost Float?
  finalCost     Float?

  shopId     String
  customerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  statusHistory RepairStatusHistory[]
  payments      Payment[]

  @@unique([shopId, ticketNumber])
  @@index([shopId, status])
  @@index([customerId])
}

// ==================== REPAIR STATUS HISTORY ====================

model RepairStatusHistory {
  id             String       @id @default(uuid())
  repairTicketId String
  oldStatus      RepairStatus?
  newStatus      RepairStatus
  note           String?
  changedAt      DateTime     @default(now())

  repairTicket RepairTicket @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)

  @@index([repairTicketId, changedAt])
}

// ==================== PAYMENT ====================

model Payment {
  id            String        @id @default(uuid())
  amount        Float
  method        PaymentMethod
  status        PaymentStatus @default(SUCCESS)
  transactionId String?
  note          String?
  paidAt        DateTime      @default(now())

  shopId         String
  repairTicketId String

  shop         Shop         @relation(fields: [shopId], references: [id], onDelete: Restrict)
  repairTicket RepairTicket @relation(fields: [repairTicketId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, paidAt])
  @@index([repairTicketId])
}
